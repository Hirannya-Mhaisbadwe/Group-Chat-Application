# Copy this file to .env.local for local development
# For production (Vercel), set VITE_WS_URL in the Vercel dashboard under Environment Variables
#
# Local:       ws://localhost:8000/ws
# Production:  wss://<your-render-app>.onrender.com/ws   ← note wss:// (secure)
VITE_WS_URL=ws://localhost:8000/ws
